{"step_index":2199,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-07-11T16:06:07Z","content":"Created At: 2026-07-11T16:06:07Z\nCompleted At: 2026-07-11T16:06:08Z\nFile Path: `file:///home/bimatkeo/Documents/Translator/Bimatkeo_Translator/app/core/langs/verify.py`\nTotal Lines: 75\nTotal Bytes: 3031\nShowing lines 1 to 75\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: =============================================================================\n3: INTEGRITY NOTES (For AI Agents):\n4: - MODULE: app.core.langs.verify\n5: - RESPONSIBILITY: Integrity and sanity check for localization vs UI map.\n6: - CALLED BY: app.core.langs.manager\n7: - CALLS TO: None\n8: - IN = OUT: Evaluates dictionaries, returns validation results/warnings.\n9: =============================================================================\n10: \"\"\"\n11: \n12: from typing import Dict, Any, List\n13: \n14: class LanguageVerifier:\n15:     def __init__(self, localization: Dict[str, Any]):\n16:         self.localization = localization\n17: \n18:     def run_verification(self, raw_ui_map: dict):\n19:         \"\"\"\n20:         Cross-checks loaded localization dictionaries against the raw UI Map.\n21:         Reports missing translations and orphaned keys.\n22:         \"\"\"\n23:         print(\"[LanguageVerifier] Running integrity check on languages...\")\n24:         if not self.localization:\n25:             print(\"  [!] No localization files loaded.\")\n26:             return\n27: \n28:         # Extract all needed keys from raw_ui_map\n29:         required_tabs = set()\n30:         required_settings = set()\n31:         required_enums = set()\n32: \n33:         for tab_name, widgets in raw_ui_map.items():\n34:             if tab_name.startswith(\"__\"):\n35:                 continue\n36:             required_tabs.add(tab_name)\n37:             \n38:             for key, info in widgets.items():\n39:                 if not isinstance(info, dict):\n40:                     continue\n41:                 required_settings.add(key)\n42:                 if \"values\" in info and isinstance(info[\"values\"], list):\n43:                     for v in info[\"values\"]:\n44:                         required_enums.add(v)\n45: \n46:         for lang_id, lang_data in self.localization.items():\n47:             print(f\"  -> Verifying language '{lang_id}'...\")\n48:             lang_tabs = set(lang_data.get(\"tabs\", {}).keys())\n49:             lang_settings = set(lang_data.get(\"settings\", {}).keys())\n50:             lang_enums = set(lang_data.get(\"enums\", {}).keys())\n51: \n52:             # Check missing\n53:             missing_tabs = required_tabs - lang_tabs\n54:             missing_settings = required_settings - lang_settings\n55:             missing_enums = required_enums - lang_enums\n56: \n57:             if missing_tabs:\n58:                 print(f\"     [Missing Tabs]: {', '.join(missing_tabs)}\")\n59:             if missing_settings:\n60:                 print(f\"     [Missing Settings]: {', '.join(missing_settings)}\")\n61:             if missing_enums:\n62:                 print(f\"     [Missing Enums]: {', '.join(missing_enums)}\")\n63: \n64:             # Check orphans (defined in language file but not in UI map)\n65:             orphan_tabs = lang_tabs - required_tabs\n66:             orphan_settings = lang_settings - required_settings\n67:             orphan_enums = lang_enums - required_enums\n68: \n69:             if orphan_tabs:\n70:                 print(f\"     [Orphan Tabs]: {', '.join(orphan_tabs)}\")\n71:             if orphan_settings:\n72:                 print(f\"     [Orphan Settings]: {', '.join(orphan_settings)}\")\n73:             if orphan_enums:\n74:                 print(f\"     [Orphan Enums]: {', '.join(orphan_enums)}\")\n75: \nThe above content shows the entire, complete file contents of the requested file.\n"}
