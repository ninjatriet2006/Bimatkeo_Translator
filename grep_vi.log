  self.verifier = LanguageVerifier(self.localization)\n33: \n34:     def run_verification(self, raw_ui_map: dict):\n35:         self.verifier.run_verification(raw_ui_map)\n36: \n37:     def get_lang_data(self, lang_id: str) -> dict:\n38:         return self.fallback.get_lang_data(lang_id)\n39: \n40:     def resolve_app_language(self, oldsession_config: dict) -> str:\n41:         return self.fallback.resolve_app_language(oldsession_config)\n42: \n43:     def apply_language_to_ui_map(self, raw_ui_map: dict, lang_id: str) -> dict:\n44:         return self.ui_mapper.apply_language_to_ui_map(raw_ui_map, lang_id)\n45: \n46:     def get_string(self, lang_id: str, string_id: str, **kwargs) -> str:\n47:         \"\"\"\n48:         Retrieves a translated string by its ID. Supports parameter formatting via **kwargs.\n49:         \"\"\"\n50:         lang_data = self.get_lang_data(lang_id)\n51:         if not lang_data:\n52:             return string_id\n53: \n54:         messages = lang_data.get(\"messages\", {})\n55:         ui_strings = lang_data.get(\"ui_strings\", {})\n56: \n57:         translated_text = messages.get(string_id)\n58:         if translated_text is None:\n59:             translated_text = ui_strings.get(string_id)\n60: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
