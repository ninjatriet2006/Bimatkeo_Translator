     if label_text == info.get(\"key\", \"\"):\n30:                 label_text = info.get(\"label\", \"\")\n31:             widget = QLabel(label_text)\n32:             widget.setProperty(\"lang_id\", info.get(\"key\", \"\"))\n33:      \n<truncated 5715 bytes>\n          elif widget_type not in [\"combobox_fonts\", \"entry_with_button\", \"translator_chain_builder\", \"api_key_manager\", \"api_profile_selector\", \"pool_profile_selector\", \"ai_model_selector\"]:\n135:                 if info.get('recommendation'):\n136:                     try:\n137:                         from app.core.desktop.logic.recommend import get_recommended_size\n138:                         rec_size = get_recommended_size()\n139:                         rec_label = QLabel(f\"(Recommend: {rec_size})\")\n140:                         rec_label.setStyleSheet(\"color: #4CAF50; font-size: 11px; font-style: italic;\")\n141:                         right_layout.addWidget(rec_label)\n142:                     except Exception:\n143:                         pass\n144:                 else:\n145:                     spacer = QWidget()\n146:                     spacer.setFixedWidth(30)\n147:                     right_layout.addWidget(spacer)\n148: \n149:             row_layout.addWidget(right_container, stretch=2)\n150: \n151:             if context_key:\n152:                 self.mw.task_widgets[context_key][info['key']] = widget\n153:                 if not hasattr(self.mw, 'task_rows'):\n154:                     self.mw.task_rows = {}\n155:                 if context_key not in self.mw.task_rows:\n156:                     self.mw.task_rows[context_key] = {}\n157:                 self.mw.task_rows[context_key][info['key']] = row_widget\n158:                 initial_value = self.mw.task_settings[context_key].get(info['key'])\n159:             else:\n160:                 self.mw.setting_widgets[info['key']] = widget\n161:                 self.mw.setting_rows[info['key']] = row_widget\n162:                 initial_value = self.mw.current_settings.get(info['key'])\n163: \n164:             self.mw._set_widget_value(info['key'], initial_value, widget)\n165:             self.mw._connect_widget_signal(info['key'], widget, context_key)\n166: \n167:         return row_widget\n168: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
