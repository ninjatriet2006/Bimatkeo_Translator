{"step_index":380,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-07-11T12:26:18Z","content":"Created At: 2026-07-11T12:26:18Z\nCompleted At: 2026-07-11T12:26:18Z\nFile Path: `file:///home/bimatkeo/Documents/Translator/Bimatkeo_Translator/app/core/langs/loader.py`\nTotal Lines: 45\nTotal Bytes: 1787\nShowing lines 1 to 45\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: =============================================================================\n3: INTEGRITY NOTES (For AI Agents):\n4: - MODULE: app.core.langs.loader\n5: - RESPONSIBILITY: Scans and loads .yaml localization files from .config/langs/.\n6: - CALLED BY: app.core.langs.manager\n7: - CALLS TO: None\n8: - IN = OUT: Reads YAML files and returns Python dictionaries.\n9: =============================================================================\n10: \"\"\"\n11: \n12: import os\n13: from typing import Dict, Any\n14: \n15: class LanguageLoader:\n16:     def __init__(self, project_base_dir: str):\n17:         self.langs_dir = os.path.join(project_base_dir, \".config\", \"langs\")\n18: \n19:     def load_localization_files(self) -> Dict[str, Any]:\n20:         \"\"\"Scans the langs directory and loads all .yaml or .yml files.\"\"\"\n21:         localization = {}\n22:         if not os.path.exists(self.langs_dir):\n23:             return localization\n24: \n25:         from ruamel.yaml import YAML\n26:         yaml = YAML(typ='safe')\n27:         \n28:         try:\n29:             for filename in os.listdir(self.langs_dir):\n30:                 if filename.endswith(\".yaml\") or filename.endswith(\".yml\"):\n31:                     file_path = os.path.join(self.langs_dir, filename)\n32:                     with open(file_path, \"r\", encoding=\"utf-8\") as f:\n33:                         data = yaml.load(f) or {}\n34:                     \n35:                     lang_id = data.get(\"id\")\n36:                     if not lang_id:\n37:                         lang_id = os.path.splitext(filename)[0]\n38:                         print(f\"[LanguageLoader] Warning: {filename} missing 'id' field. Falling back to filename '{lang_id}'.\")\n39:                         \n40:                     localization[lang_id] = data\n41:         except Exception as e:\n42:             print(f\"[LanguageLoader] Error loading files in langs directory: {e}\")\n43:             \n44:         return localization\n45: \nThe above content shows the entire, complete file contents of the requested file.\n"}
