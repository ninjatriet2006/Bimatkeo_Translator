ain\": colors.get(\"background_main\", \"#2d2d2d\"),\n79:             \"background_frame\": colors.get(\"background_frame\", \"#2d2d2d\"),\n80:             \"primary_button\": colors.get(\"primary_button\", \"#3a7ebf\"),\n81:             \"primary_button_hover\": colors.get(\"primary_button_hover\", \"#56a9e8\"),\n82:             \"slider_groove\": colors.get(\"slider_groove\", \"#242424\"),\n83:             \"slider_handle\": colors.get(\"slider_handle\", \"#3a7ebf\"),\n84:             \"text_main\": colors.get(\"text_main\", \"#dce4ee\"),\n85:             \"border\": colors.get(\"border\", \"#555555\"),\n86:             \"accent\": colors.get(\"accent\", \"#4a9fcf\"),\n87:             \"arrow_icon_path\": arrow_icon_path\n88:         }\n89: \n90:         qss_path = os.path.join(self.mw.project_base_dir, \"themes\", \"template.qss\")\n91:         if os.path.exists(qss_path):\n92:             with open(qss_path, \"r\", encoding=\"utf-8\") as f:\n93:                 qss_content = f.read()\n94:             template = string.Template(qss_content)\n95:             style_sheet = template.safe_substitute(mapping)\n96:             self.mw.setStyleSheet(style_sheet)\n97:         \n98:         self.mw.log(\"INFO\", f\"Theme '''{theme_name}''' applied successfully.\")\n99: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
