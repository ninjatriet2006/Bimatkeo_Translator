{"step_index":2649,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-07-12T11:06:44Z","content":"Created At: 2026-07-12T11:06:44Z\nCompleted At: 2026-07-12T11:06:44Z\nFile Path: `file:///home/bimatkeo/Documents/Translator/Bimatkeo_Translator/app/core/downloader/manager.py`\nTotal Lines: 76\nTotal Bytes: 3154\nShowing lines 1 to 76\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: =============================================================================\n3: INTEGRITY NOTES (For AI Agents):\n4: - MODULE: app.core.downloader.manager\n5: - RESPONSIBILITY: Central manager for all downloading, caching, verifying, and extracting tasks.\n6: - CALLED BY: Various models and services requiring external assets.\n7: - CALLS TO: app.core.downloader.utils\n8: - IN = OUT: Executes DownloadTask -> returns True/False.\n9: =============================================================================\n10: \"\"\"\n11: import os\n12: import urllib.request\n13: from typing import Callable, Optional\n14: from .models import DownloadTask, TaskStatus\n15: from .utils import CacheChecker, ChecksumVerifier, FileExtractor\n16: \n17: class DownloadManager:\n18:     \"\"\"Quản lý và thực thi các tác vụ tải xuống theo trình tự: cache -> download -> verify -> extract.\"\"\"\n19: \n20:     def __init__(self):\n21:         self.cache_checker = CacheChecker()\n22:         self.checksum_verifier = ChecksumVerifier()\n23:         self.extractor = FileExtractor()\n24: \n25:     def execute(self, task: DownloadTask, log_callback: Optional[Callable[[str, str], None]] = None) -> bool:\n26:         \"\"\"Thực thi toàn bộ luồng tải xuống.\"\"\"\n27:         if self.cache_checker.check(task, log_callback):\n28:             return True\n29: \n30:         os.makedirs(task.target_dir, exist_ok=True)\n31:         download_path = os.path.join(task.target_dir, task.filename)\n32: \n33:         try:\n34:             self._download(task, download_path, log_callback)\n35:             self.checksum_verifier.check(task, download_path, log_callback)\n36:             self.extractor.extract(task, download_path, log_callback)\n37: \n38:             task.status = TaskStatus.COMPLETED\n39:             return True\n40: \n41:         except Exception as e:\n42:             task.status = TaskStatus.FAILED\n43:             task.error_message = str(e)\n44: \n45:             msg = f\"Lỗi trong quá trình tải/giải nén: {e}\"\n46:             if log_callback:\n47:                 log_callback(\"ERROR\", msg)\n48:             else:\n49:                 print(f\"[LOG:ERROR] {msg}\")\n50: \n51:             if os.path.exists(download_path):\n52:                 os.remove(download_path)\n53:             return False\n54: \n55:     def _download(self, task: DownloadTask, download_path: str, log_callback=None):\n56:         \"\"\"Tải file từ URL về thư mục đích.\"\"\"\n57:         task.status = TaskStatus.DOWNLOADING\n58:         msg = f\"Bắt đầu tải mô hình từ: {task.url}\"\n59:         if log_callback: log_callback(\"INFO\", msg)\n60:         else: print(f\"[LOG:INFO] {msg}\")\n61: \n62:         def _reporthook(count, block_size, total_size):\n63:             if total_size > 0:\n64:                 percent = min(int(count * block_size * 100 / total_size), 100)\n65:                 task.progress = percent\n66:                 if count % max(1, (total_size // block_size // 10)) == 0:\n67:                     prog_msg = f\"Đang tải {task.filename}... {percent}%\"\n68:                     if log_callback: log_callback(\"INFO\", prog_msg)\n69:                     else: print(f\"[LOG:INFO] {prog_msg}\")\n70: \n71:         urllib.request.urlretrieve(task.url, download_path, reporthook=_reporthook)\n72: \n73:         done_msg = f\"Tải hoàn tất: {task.filename}\"\n74:         if log_callback: log_callback(\"INFO\", done_msg)\n75:         else: print(f\"[LOG:INFO] {done_msg}\")\n76: \nThe above content shows the entire, complete file contents of the requested file.\n"}
