{"step_index":304,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-07-11T12:07:23Z","content":"Created At: 2026-07-11T12:07:23Z\nCompleted At: 2026-07-11T12:07:23Z\nFile Path: `file:///home/bimatkeo/Documents/Translator/Bimatkeo_Translator/app/core/desktop/components/widget_factory/specialized_widgets.py`\nTotal Lines: 390\nTotal Bytes: 15681\nShowing lines 1 to 390\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import os\n2: from PySide6.QtWidgets import (\n3:     QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton, QFrame,\n4:     QListWidget, QListWidgetItem, QMessageBox, QComboBox\n5: )\n6: from PySide6.QtCore import Qt, QTimer\n7: from PySide6.QtGui import QColor\n8: \n9: from app.core.desktop.components.widgets_helper import DynamicHeightListWidget, NoScrollComboBox, SearchableComboBox\n10: from app.core.desktop.constants import INSTALL_NEW_FONT, UPDATE_ALL_FONTS\n11: \n12: class SpecializedWidgetFactory:\n13:     def __init__(self, main_window):\n14:         self.mw = main_window\n15: \n16:     def create_api_profile_selector(self, info: dict) -> QWidget:\n17:         container = QWidget()\n18:         layout = QHBoxLayout(container)\n19:         layout.setContentsMargins(0, 0, 0, 0)\n20:         layout.setSpacing(5)\n21:         \n22:         service = info.get(\"service\", \"Translator\")\n23:         \n24:         combo = SearchableComboBox()\n25:         profiles = self.mw._load_api_profiles()\n26:         \n27:         filtered_profiles = [name for name, p in profiles.items() if p.get(\"type\", p.get(\"group\", \"Standalone\")) == \"Standalone\" and p.get(\"service\", \"Translator\") == service]\n28:             \n29:         combo.addItem(\"--- Select ---\")\n30:         combo.addItems(filtered_profiles)\n31:         \n32:         default_val = self.mw.current_settings.get(info['key'], info.get(\"default\", \"\"))\n33:         combo.setCurrentText(str(default_val) if default_val else \"--- Select ---\")\n34:             \n35:         layout.addWidget(combo, \n<truncated 14021 bytes>\n;')\n349:         code_to_lang_name = {v: k for k, v in mw_module.LANGUAGES.items()}\n350: \n351:         for step in steps:\n352:             parts = step.split(':')\n353:             if len(parts) == 2:\n354:                 translator_name, lang_code = parts\n355: \n356:                 step_widget = self.create_chain_step_widget()\n357:                 list_item = QListWidgetItem(self.mw.chain_list_widget)\n358:                 list_item.setSizeHint(step_widget.sizeHint())\n359:                 self.mw.chain_list_widget.addItem(list_item)\n360:                 self.mw.chain_list_widget.setItemWidget(list_item, step_widget)\n361: \n362:                 lang_name = code_to_lang_name.get(lang_code, \"\")\n363:                 if lang_name:\n364:                     getattr(step_widget, \"lang_combo\").setCurrentText(lang_name)\n365:                 \n366:                 # Manual inline combobox setting\n367:                 combo_box = getattr(step_widget, \"translator_combo\")\n368:                 index = -1\n369:                 for i in range(combo_box.count()):\n370:                     if combo_box.itemData(i) == translator_name:\n371:                         index = i\n372:                         break\n373:                 if index != -1:\n374:                     combo_box.setCurrentIndex(index)\n375:                 else:\n376:                     combo_box.setCurrentText(translator_name)\n377: \n378:         self.mw.chain_list_widget.updateGeometry()\n379: \n380:     def update_chain_ui_state(self):\n381:         if hasattr(self.mw, 'chain_list_widget'):\n382:             enable_chain = getattr(self.mw, 'chain_list_widget_enabled', False)\n383:             self.mw.chain_list_widget.setEnabled(enable_chain)\n384:             self.update_chain_list_height()\n385:             \n386:     def update_chain_list_height(self):\n387:         if not hasattr(self.mw, 'chain_list_widget'):\n388:             return\n389:         self.mw.chain_list_widget.updateGeometry()\n390: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
