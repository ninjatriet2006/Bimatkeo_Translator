QWidget {
    font-size: $font_size;
    background-color: $background_main;
    color: $text_main;
}
QFrame#StyledPanel, QFrame#LeftPanel {
    background-color: $background_frame;
    border: 1px solid $border;
    border-radius: 5px;
}
QPushButton {
    background-color: $primary_button;
    color: $text_main;
    border: 1px solid $border;
    padding: 5px;
    border-radius: 3px;
}
QPushButton:hover {
    background-color: $primary_button_hover;
}
QPushButton:checked {
    background-color: $accent;
    color: white;
    border: 2px solid $accent;
}
QPushButton:checked:hover {
    background-color: $accent;
    border: 2px solid $accent;
    color: white;
}
QPushButton:disabled { background-color: #555555; color: #888888; }

QComboBox, QLineEdit {
    background-color: $background_main;
    color: $text_main;
    border: 1px solid $border;
    border-radius: 3px;
    padding: 4px;
}
QComboBox {
    padding-right: 24px;
}
QComboBox[warning="true"] {
    color: #888888;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border: none;
}
QComboBox::down-arrow {
    image: url($arrow_icon_path);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: $background_main;
    color: $text_main;
    border: 1px solid $border;
    selection-background-color: $accent;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid $border;
    border-radius: 3px;
}
QCheckBox::indicator:unchecked { 
    background-color: $background_main; 
}
QCheckBox::indicator:checked {
    background-color: $accent;
    border-color: $accent;
}

QSlider::groove:horizontal {
    border: 1px solid $border;
    background: $slider_groove;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: $slider_handle;
    border: 1px solid $slider_handle;
    width: 14px;
    margin: -6px 0; 
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: $primary_button_hover;
    border: 1px solid $primary_button_hover;
}
QListWidget, QTextEdit {
    background-color: $background_main;
    color: $text_main;
    border: 1px solid $border;
    border-radius: 3px;
}
QTabWidget::pane {
    background-color: $background_main;
    border: 1px solid $border;
    border-radius: 5px;
}
QTabBar::tab {
    background: $background_main;
    padding: 6px;
    border: 1px solid $border;
    border-bottom: none;
}
QTabBar::tab:selected {
    background: $background_frame;
    color: $text_main;
    border-bottom: 1px solid $background_frame;
}
QTabBar::tab:!selected {
    background: $background_main;
    color: $text_main;
}
QTabBar::tab:!selected:hover {
    background: $background_frame;
}
QToolTip {
    color: $text_main;
    background-color: $background_frame;
    border: 1px solid $border;
}
